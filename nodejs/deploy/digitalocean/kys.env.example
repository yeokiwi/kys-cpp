# Settings of the kys-cpp web server, read by docker compose (--env-file).
# setup.sh writes /opt/kys/kys.env from the variables it is given; edit that
# file and run setup.sh again (or docker compose up -d) to apply changes.

# Domain name pointing to the droplet (DNS A record). Leave empty to serve
# plain HTTP on the droplet's IP address. Gamepads only work over HTTPS.
KYS_DOMAIN=

# Password protection (HTTP basic authentication). Everybody who can open the
# game shares the save slots and settings, so keep it on for public servers.
KYS_AUTH_USER=player
KYS_AUTH_PASSWORD=

# Folder with the game resources (resource/, save/, config/, music/, ...)
KYS_GAME_DIR=/opt/kys/game
